# Copy to .env. Do NOT put secrets here: store them in the macOS Keychain
# (service name below) and reference them by key name only.

APP_ENV=local
APP_TIMEZONE=Asia/Kolkata
KEYCHAIN_SERVICE=india-stock-analyzer

# Local SQLite database (git-ignored)
ISA_DB_PATH=./data/isa.db

# Broker MCP endpoints are configured in .mcp.json (Claude Code holds the sign-ins):
#   INDmoney https://mcp.indmoney.com/mcp, Kite https://mcp.kite.trade/mcp

# 5paisa Xstream API - read-only (holdings, today's trades, daily candles). Values from your
# Xstream dashboard (https://xstream.5paisa.com/dashboard). These are not secrets.
FIVEPAISA_USER_KEY=
FIVEPAISA_USER_ID=
FIVEPAISA_CLIENT_CODE=
# Redirect URL registered for your API key. A 127.0.0.1 URL lets `fivepaisa login` capture it automatically.
FIVEPAISA_RESPONSE_URL=http://127.0.0.1:8765/5paisa/callback
# SECRET - store in the Keychain, never here:
#   security add-generic-password -s india-stock-analyzer -a fivepaisa_encryption_key -w
# (it prompts for the value). The daily access token is stored there automatically.

# Folder for manual downloads (NSE/BSE files, Screener/Tijori exports, CAS PDFs)
IMPORT_DIR=./data/imports

# Safety: the tool never places orders. Order/GTT MCP tools are denied in .claude/settings.json.

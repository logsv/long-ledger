# Copy to .env. Do NOT put secrets here: store them in the macOS Keychain
# (service name below) and reference them by key name only.

APP_ENV=local
APP_TIMEZONE=Asia/Kolkata
KEYCHAIN_SERVICE=india-stock-analyzer

# Local SQLite database (git-ignored)
ISA_DB_PATH=./data/isa.db

# Broker MCP endpoints are configured in .mcp.json (Claude Code holds the sign-ins):
#   INDmoney https://mcp.indmoney.com/mcp, Kite https://mcp.kite.trade/mcp

# 5paisa Xstream REST API - read-only endpoints only (holdings, positions, trade book, order book, historical candles)
# Daily login uses 5paisa's own OAuth web page (you enter PIN/TOTP there); no TOTP seed or PIN is stored.
# Secrets in Keychain: fivepaisa_encryption_key
FIVEPAISA_APP_KEY=
FIVEPAISA_USER_ID=
FIVEPAISA_CLIENT_CODE=

# Folder for manual downloads (NSE/BSE files, Screener/Tijori exports, CAS PDFs)
IMPORT_DIR=./data/imports

# Safety: the tool never places orders. Order/GTT MCP tools are denied in .claude/settings.json.

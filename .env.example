# Copy to .env. Do NOT put secrets here: store them in the macOS Keychain
# (service name below) and reference them by key name only.

APP_ENV=local
APP_TIMEZONE=Asia/Kolkata
KEYCHAIN_SERVICE=india-stock-analyzer

# Database (local only)
DATABASE_URL=postgresql://isa:CHANGE_ME@localhost:5432/isa

# MCP endpoints (official)
INDMONEY_MCP_URL=https://mcp.indmoney.com/mcp
KITE_MCP_URL=https://mcp.kite.trade/mcp

# Kite Connect REST fallback (secret lives in Keychain under kite_api_secret)
KITE_API_KEY=
# 5paisa Xstream REST (secrets in Keychain: fivepaisa_app_secret, fivepaisa_totp_seed)
FIVEPAISA_APP_KEY=
FIVEPAISA_CLIENT_CODE=

# Safety switches
ORDER_PLACEMENT_ENABLED=false
MCP_TOOL_ALLOWLIST=get_holdings,get_positions,get_trades,get_orders,get_ohlc,get_historical_data,get_quotes,search_instruments

# Alerts (bot token in Keychain under telegram_bot_token)
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
